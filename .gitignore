# Build artifacts
app/.build/
app/dist.noindex/
.build/
dist.noindex/
*.o
*.swiftmodule

# Python caches
__pycache__/
*.pyc

# Credentials & runtime state — MUST never be committed.
# QuotaBar's own runtime data lives OUTSIDE this repo (the bank in ~/.claude/accounts,
# the installed scripts in ~/.local/share/quotabar, the log in ~/Library/Logs). These
# patterns are belt-and-suspenders in case a runtime dir is ever created or symlinked
# inside the tree.
accounts/
**/accounts/*.json
*.credentials.json
.credentials.json
.config.json
.usage-cache.json
.swap-journal.json
.autoping.log
.keychain-snapshots/
*.pid
homes/
*.lease
*.journal
daemon.status.json
.env

# Install-time resolved artifacts (machine-specific paths — never committed)
hooks-fragment.resolved.json

# Scratch: review output, logs, retired files
out.txt
*_review*.txt
retired/
*.log
*.err

# macOS
.DS_Store

# Release artifacts (uploaded to GitHub Releases, never committed)
QuotaBar-*.zip
