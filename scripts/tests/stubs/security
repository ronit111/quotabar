#!/bin/bash
# Stub `security` for account-bank tests. The single keychain item is stored as a
# raw blob in $STUB_KC_FILE. Behaviour is controlled by $STUB_KC_MODE:
#   normal (default) : reads/writes the store honestly
#   readfail         : find-generic-password exits nonzero (item "absent")
#   writeignore      : `-i` accepts the write, exits 0, but the store is UNCHANGED
#                      (simulates a write that reported success without landing)
#   writefail        : `-i` exits nonzero, store unchanged
#   writelate        : `-i` sleeps past the caller's timeout then writes (tests the
#                      indeterminate/post-verify path)
store="${STUB_KC_FILE:-/tmp/stub_kc.json}"
mode="${STUB_KC_MODE:-normal}"
cmd="$1"; shift
case "$cmd" in
  find-generic-password)
    [ "$mode" = "readfail" ] && exit 44
    # (r15 #3) a TRANSIENT read failure: the item's presence is UNKNOWN. Distinct from
    # readfail's 44 (errSecItemNotFound = confirmed absent) precisely because callers that
    # delete things must not treat "could not look" as "nothing is there".
    [ "$mode" = "readerror" ] && exit 1
    if [ "$mode" = "empty_recheck" ]; then
      # (r5 #1) first read returns the store; the SECOND+ read returns EMPTY/absent,
      # simulating a keychain that becomes unreadable between kc_write's snapshot and
      # its final pre-write re-read. The empty re-read must NOT bypass the gate.
      cnt="${store}.rdcount"
      n=$(cat "$cnt" 2>/dev/null || echo 0); n=$((n + 1)); printf '%s' "$n" > "$cnt"
      if [ "$n" -ge 2 ]; then exit 44; fi
    fi
    if [ "$mode" = "rotate_recheck" ]; then
      # (r4 #2) first read returns the store; the SECOND+ read returns a ROTATED
      # blob, simulating an external /login landing between kc_write's snapshot read
      # and its write syscall.
      cnt="${store}.rdcount"
      n=$(cat "$cnt" 2>/dev/null || echo 0); n=$((n + 1)); printf '%s' "$n" > "$cnt"
      if [ "$n" -ge 2 ]; then
        printf '{"claudeAiOauth":{"accessToken":"ROTATED","refreshToken":"rROT","expiresAt":333}}'
        exit 0
      fi
    fi
    if [ -f "$store" ]; then cat "$store"; exit 0; else exit 44; fi ;;
  add-generic-password)
    exit 0 ;;
  -i)
    read -r line
    [ "$mode" = "writefail" ] && exit 1
    [ "$mode" = "writeignore" ] && exit 0
    [ "$mode" = "writelate" ] && sleep 30
    blob="${line#*-w }"
    # (v112) Model `security -i`'s own unquoting. kc_write now passes the blob as a
    # DOUBLE-QUOTED token with backslashes and quotes escaped, because CLI 2.1.235's
    # mcpOAuth carries a space-delimited OAuth scope and a bare token containing a space
    # does not write at all. The real binary strips the quotes and the escapes; a stub
    # that stored the escaped text would quietly disagree with production and let the
    # suite pass against an encoding that does not survive a real write. (Verified
    # against /usr/bin/security on a throwaway item before this was written.)
    case "$blob" in
      \"*\") blob="$(printf '%s' "$blob" | python3 -c 'import sys
s = sys.stdin.read()
s = s[1:-1] if len(s) >= 2 else s
sys.stdout.write(s.replace(chr(92)+chr(34), chr(34)).replace(chr(92)*2, chr(92)))')" ;;
    esac
    printf '%s' "$blob" > "$store"
    exit 0 ;;
  *) exit 0 ;;
esac
